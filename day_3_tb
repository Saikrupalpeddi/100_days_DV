module counter_tb;
  reg clk,rst;
  wire [2:0] count;
  
  initial begin
    clk=0;
    forever #20 clk=~clk;
  end
  
  counter dut(.clk(clk),.rst(rst),.count(count));
  
  initial begin
    $monitor("clk=%b,rst=%b,count=%b",clk,rst,count);
  end
  
  initial begin
    rst=1; #40;
    rst=0; #200;
    $finish;
  end
  
 initial begin
   $dumpfile("counter_tb.vcd");   
   $dumpvars(0, counter_tb);   
end
endmodule
